{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"],
    "paths": { "@jarvis/shared": ["../shared/src/protocol.ts"] }
  },
  "include": ["main", "preload", "renderer", "e2e", "*.config.ts"]
}
