{
  "name": "@jarvis/desk",
  "version": "0.0.1",
  "private": true,
  "description": "JARVIS Desk: the macOS overlay app for JARVIS",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "esbuild main/index.ts --bundle --platform=node --format=cjs --external:electron --alias:@jarvis/shared=../shared/src/protocol.ts --outfile=dist-electron/main.cjs && esbuild preload/index.ts --bundle --platform=node --format=cjs --external:electron --alias:@jarvis/shared=../shared/src/protocol.ts --outfile=dist-electron/preload.cjs",
    "build:renderer": "vite build",
    "build:web": "vite build --mode web",
    "dev": "vite",
    "start": "npm run build && electron .",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "author": "Matthew Sharp"
}
