# Copy to .env and fill in. Never commit .env.

# From @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID. Leave empty at first: send /start to the bot and it replies with it.
TELEGRAM_ALLOWED_CHAT_ID=

# The routine that starts new cloud sessions: claude.ai/code/routines → your routine →
# Add another trigger → API → Generate token. The ID starts with trig_, the token with sk-ant-oat01-.
ROUTINE_ID=
ROUTINE_TOKEN=

# Don't set CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY here: they override the claude.ai login,
# and cloud sessions can't be steered with them. Log in once instead (see README).
