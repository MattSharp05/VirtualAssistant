# Copy to .env and fill in. Never commit .env.

# --- Starting cloud sessions ---
# New tasks become normal cloud sessions (they show in the Claude Code sidebar), created with the
# container's `claude auth login`. The repo they run on unless the task names a project from PROJECTS:
DEFAULT_REPO=https://github.com/MattSharp05/VirtualAssistant
# The cloud environment they run in (env_…, from the session's environment picker). Empty = the default.
SESSION_ENVIRONMENT_ID=
# Fallback only, when the sessions API is unavailable: the JARVIS Worker routine.
# claude.ai/code/routines → your routine → Add another trigger → API → Generate token.
# The ID starts with trig_, the token with sk-ant-oat01-.
ROUTINE_ID=
ROUTINE_TOKEN=

# --- Dashboard ---
# Optional. The dashboard is only on this machine (and your tailnet, with Tailscale), so a password
# is only needed if you ever expose it some other way.
DASHBOARD_PASSWORD=

# --- Reports in the dashboard (Tailscale) ---
# Turns on the Tailscale container. Leave empty to run without it.
COMPOSE_PROFILES=
# From login.tailscale.com/admin/settings/keys → Generate auth key (only used on first start).
TS_AUTHKEY=
# The machine's name in your tailnet; the address becomes https://<this>.<tailnet>.ts.net
TS_HOSTNAME=jarvis
# Secret that cloud sessions send with each report. Generate with: openssl rand -hex 32
# The same value goes in the JARVIS cloud environment as JARVIS_REPORT_SECRET.
REPORT_SECRET=

# --- The brain (talk to JARVIS in plain language) ---
# Runs on your Claude subscription through the CLI. Model the brain starts with (switch any time on
# the dashboard or with /model in Telegram). Full model ids; the list of choices is BRAIN_MODELS.
BRAIN_MODEL=claude-sonnet-5-5
# BRAIN_MODELS=claude-sonnet-5-5,claude-haiku-5-5,claude-opus-5-5
# JARVIS keeps one chat process running so replies start streaming in ~1 s. 0 = start one per message (slower).
# BRAIN_WARM=1
# Your time zone: reminder times, "today" and the time JARVIS sees on each message.
# TZ=Europe/London
# The model for background jobs (Today digest every 30 min, 07:00-22:00). Default: haiku.
# WORKER_MODEL=claude-haiku-5-5
# Voice notes are transcribed in the container (whisper.cpp, base English model, built into the image).
# Only change these if you mount your own build/model: WHISPER_BIN, WHISPER_MODEL, FFMPEG_BIN.
# Voice replies are spoken in the container too (Piper, en_GB-alan-medium, built into the image);
# /voice on|off|auto in Telegram. Overrides: PIPER_BIN, PIPER_MODEL.
# claude.ai connectors JARVIS's chat may READ (connect them at claude.ai → Settings → Connectors).
# Writing (sending email, changing events) stays blocked. Calendar writes are JARVIS's own tools now
# (GOOGLE_CALENDAR_* below), not a connector; "Google Calendar" here only feeds the background Today
# digest / Calendar window job, which still reads through the connector. Set to "none" to turn off.
# BRAIN_CONNECTORS=Google Calendar,Gmail,Slack

# Notion, read-only: notion.so/my-integrations → New integration (Internal) → copy the secret.
# Then share pages/databases with it (page ••• menu → Connections → JARVIS). It sees nothing else.
NOTION_TOKEN=

# --- Calendar (first-party; JD-77) ---
# JARVIS creates, edits, deletes and RSVPs to events directly through the Google Calendar API, no
# claude.ai connector needed. One-time setup, on your Mac (it needs a browser), not in the container:
#   1. console.cloud.google.com → a project → enable the "Google Calendar API".
#   2. APIs & Services → OAuth consent screen → add yourself as a test user (or publish it).
#   3. APIs & Services → Credentials → Create OAuth client ID → Desktop app → copy the Client ID/Secret.
#   4. npm run setup:calendar -- --client-id <id> --client-secret <secret>, approve in the browser,
#      then copy the three lines it prints below.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Which calendar (default: your primary one).
# GOOGLE_CALENDAR_ID=primary
# Time zone for event times (default: TZ above). Your Google account's calendar time zone may differ
# from where you live — check calendar.google.com → Settings → Time zone if unsure.
# GOOGLE_CALENDAR_TIMEZONE=Europe/London

# --- Agent graph (the Desk's Agents window) ---
# Projects it always shows, even with nothing running: the `project:` tag slug, a name, the Tickets
# data source (share "Claude Projects" with the integration, read only), the repo and ticket prefix.
# PROJECTS=[{"slug":"jarvis","name":"JARVIS Desk","tickets":"collection://97df4bde-6ac0-42d6-a1cc-0b0838864dfb","repo":"MattSharp05/VirtualAssistant","prefix":"JD"}]
# CI on each open PR: a fine-grained token with read-only Checks, Pull requests and Contents on your
# repos. Public repos work without it (rate-limited).
GITHUB_TOKEN=

# --- Telegram (optional) ---
# From @BotFather (/newbot). Leave empty to run dashboard-only.
TELEGRAM_BOT_TOKEN=
# Your chat ID: leave empty, send /start to the bot, and it replies with it.
TELEGRAM_ALLOWED_CHAT_ID=

# Don't set CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY here: they override the claude.ai login,
# and cloud sessions can't be steered with them. Log in once instead (see README).
