# Copy to .env and fill in. Never commit .env.

# --- Starting cloud sessions (required for new tasks) ---
# claude.ai/code/routines → your routine → Add another trigger → API → Generate token.
# The ID starts with trig_, the token with sk-ant-oat01-.
ROUTINE_ID=
ROUTINE_TOKEN=

# --- Dashboard ---
# Optional. The dashboard is only on this machine (and your tailnet, with Tailscale), so a password
# is only needed if you ever expose it some other way.
DASHBOARD_PASSWORD=

# --- Reports in the dashboard (Tailscale) ---
# Turns on the Tailscale container. Leave empty to run without it.
COMPOSE_PROFILES=
# From login.tailscale.com/admin/settings/keys → Generate auth key (only used on first start).
TS_AUTHKEY=
# The machine's name in your tailnet; the address becomes https://<this>.<tailnet>.ts.net
TS_HOSTNAME=jarvis
# Secret that cloud sessions send with each report. Generate with: openssl rand -hex 32
# The same value goes in the JARVIS cloud environment as JARVIS_REPORT_SECRET.
REPORT_SECRET=

# --- Telegram (optional) ---
# From @BotFather (/newbot). Leave empty to run dashboard-only.
TELEGRAM_BOT_TOKEN=
# Your chat ID: leave empty, send /start to the bot, and it replies with it.
TELEGRAM_ALLOWED_CHAT_ID=

# Don't set CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY here: they override the claude.ai login,
# and cloud sessions can't be steered with them. Log in once instead (see README).
