{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS: a headless personal assistant that drives Claude Code cloud sessions over Telegram",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "doctor": "node dist/src/doctor.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "sessions": "node dist/src/list-sessions.js"
  },
  "dependencies": {
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
